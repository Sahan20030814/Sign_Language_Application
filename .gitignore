# Virtual environment - never commit this, it's huge and machine-specific
venv/
env/
.venv/

# Python cache
__pycache__/
*.pyc

# VS Code
.vscode/

# Optional: comment these out if you WANT your recorded data / trained
# model tracked in git. Recorded gesture data can get large fast.
# gesture_data/
# *.h5

# PyInstaller build artifacts - regenerated by `pyinstaller ...`, never commit
build/
dist/
*.spec

# Portable Python runtime bundled for distribution - huge, regenerated
# by following the "Building a standalone .exe" steps in the README
python_embed/

# Final packaged release folder/zip - build these locally, don't commit them;
# attach the zip to a GitHub Release instead
SignBridge_Release/
*.zip
